{
  "name": "neura-harness",
  "version": "2.6.0-rc.1",
  "description": "Windows-first Neura agent harness with explicit modes, policy guardrails, recovery, and verification.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "author": "Rajveerx11",
  "homepage": "https://github.com/Rajveerx11/neura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajveerx11/neura.git"
  },
  "bugs": {
    "url": "https://github.com/Rajveerx11/neura/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "ai-agents",
    "coding-agent",
    "developer-tools",
    "powershell",
    "sandbox",
    "typescript",
    "windows",
    "wsl2"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.v1.json",
    "typecheck:v1": "tsc -p tsconfig.v1.json",
    "check:docs": "node scripts/check-docs.mjs",
    "check:pi-free": "node scripts/check-pi-free.mjs",
    "test": "node scripts/verify-harness.mjs",
    "test:v1:runtime": "node --test tests/v1-runtime.test.ts",
    "test:v1:learn": "node --test tests/v1-learn.test.ts",
    "test:v1:work-sandbox": "node --test tests/v1-work-sandbox.test.ts",
    "test:browser:learn": "node scripts/tests/learn-browser.mjs",
    "test:browser": "npm run test:browser:learn",
    "test:learn": "node scripts/verify-harness.mjs --suite learn && node scripts/verify-harness.mjs --suite learn-materials && node scripts/verify-harness.mjs --suite learn-workshop && node scripts/verify-harness.mjs --suite learn-storage && node scripts/verify-harness.mjs --suite learn-vault",
    "test:sandbox": "node scripts/verify-harness.mjs --suite sandbox",
    "verify:sandbox": "node scripts/verify-sandbox.mjs",
    "verify": "npm run typecheck && npm run check:pi-free && npm test && npm run check:docs",
    "verify:release": "node scripts/check-pi-free.mjs --distribution",
    "audit:dependencies": "npm audit --audit-level=high && npm audit --prefix agent/neura --audit-level=high",
    "audit:signatures": "npm audit signatures && npm audit signatures --prefix agent/neura",
    "audit:all": "npm run audit:dependencies && npm run audit:signatures"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@mastra/core": "1.79.0",
    "typebox": "1.4.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2"
  }
}
