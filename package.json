{
  "name": "neura-harness",
  "version": "2.6.0-rc.3",
  "description": "Windows-first terminal assistant for engineering and practical learning, with Work and Learn modes.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "author": "Rajveerx11",
  "homepage": "https://github.com/Rajveerx11/neura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajveerx11/neura.git"
  },
  "bugs": {
    "url": "https://github.com/Rajveerx11/neura/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "ai-agents",
    "coding-agent",
    "developer-tools",
    "learning",
    "powershell",
    "sandbox",
    "typescript",
    "windows",
    "wsl2"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.v1.json",
    "typecheck:v1": "tsc -p tsconfig.v1.json",
    "check:docs": "node scripts/check-docs.mjs",
    "check:pi-free": "node scripts/check-pi-free.mjs",
    "test": "node -e \"console.error('Runtime regression tests were removed at the owner request and are unavailable.'); process.exit(1)\"",
    "check:test-files": "node scripts/verify-harness.mjs",
    "verify": "npm run check:test-files && npm run typecheck && npm run check:pi-free && npm run check:docs",
    "verify:release": "node scripts/check-pi-free.mjs --distribution",
    "audit:dependencies": "npm audit --audit-level=high && npm audit --prefix agent/neura --audit-level=high",
    "audit:signatures": "npm audit signatures && npm audit signatures --prefix agent/neura",
    "audit:all": "npm run audit:dependencies && npm run audit:signatures"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/openai": "4.0.106",
    "typebox": "1.4.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "axe-core": "4.14.1",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
}
